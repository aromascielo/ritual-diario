// Publicación en Cloudflare Workers (solo archivos estáticos). Ver CLAUDE.md §9.
// Cloudflare arma la app con "npm run build" y sube la carpeta dist/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ritual-diario",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "preview_urls": true
}
